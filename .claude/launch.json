{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "autoPort": true,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/web", "dev"]
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8001"],
      "port": 8001
    }
  ]
}
