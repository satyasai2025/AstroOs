{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "autoPort": true,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/web", "dev"]
    },
    {
      "name": "web-cors-port",
      "autoPort": false,
      "port": 3001,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/web", "dev", "--port", "3001"]
    },
    {
      "name": "web-cors-port-3002",
      "autoPort": false,
      "port": 3002,
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/web", "dev", "--port", "3002"]
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "port": 8001
    }
  ]
}
