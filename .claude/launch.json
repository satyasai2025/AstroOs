{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web3000",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@workspace/web", "dev"],
      "port": 3000,
      "autoPort": false,
      "env": { "PORT": "3000" }
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "3000"],
      "port": 3000,
      "autoPort": false,
      "env": { "PORT": "3000" }
    }
  ]
}