{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrosos.local/schemas/dataset-metadata-v1.json",
  "title": "AstroOS Dataset Metadata Schema",
  "description": "Validates _metadata.json files for the AstroOS Research Dataset Repository. Codifies the 52-field standard from RDO Phase 3 §2.",
  "type": "object",
  "required": [
    "dataset_id", "name", "description", "category", "category_code",
    "type", "type_code", "version", "dataset_version",
    "provenance_tier", "source_description", "source_uris",
    "collection_method", "curator",
    "quality_score", "validation_status",
    "known_limitations", "known_biases",
    "completeness_pct", "missing_fields", "duplicate_count", "duplicate_pct",
    "license_id", "license_name", "privacy_tier", "confidence_tier", "contains_pii",
    "format", "formats_available", "record_count", "field_count",
    "file_size_bytes", "checksum_sha256", "checksum_algorithm",
    "schema_ref", "data_dictionary_ref",
    "lifecycle_stage", "created_at", "updated_at",
    "maintainer", "changelog_ref"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "dataset_id": {
      "type": "string",
      "pattern": "^ASTRO-[A-Z]{2}-[A-Z]+-v\\d+\\.\\d+\\.\\d+$",
      "description": "Permanent dataset ID (ASTRO-{CATEGORY}-{TYPE}-v{X.Y.Z})"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable dataset name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Reference", "Research", "Benchmark", "Validation",
        "QA-Test", "AI-Eval", "Synthetic", "Public",
        "Licensed", "User-Contributed"
      ]
    },
    "category_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "type": { "type": "string", "minLength": 1 },
    "type_code": {
      "type": "string",
      "pattern": "^[A-Z]{2,6}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (e.g., 1.0.0)"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^ASTRO-[A-Z]{2}-[A-Z]+-v\\d+\\.\\d+\\.\\d+$"
    },
    "supersedes": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^ASTRO-[A-Z]{2}-[A-Z]+-v\\d+\\.\\d+\\.\\d+$" }
      ]
    },
    "superseded_by": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^ASTRO-[A-Z]{2}-[A-Z]+-v\\d+\\.\\d+\\.\\d+$" }
      ]
    },
    "provenance_tier": {
      "type": "string",
      "enum": ["Primary", "Derived", "Curated", "Generated", "Contributed"]
    },
    "source_description": { "type": "string", "minLength": 1 },
    "source_uris": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "minItems": 0
    },
    "source_version": { "type": "string" },
    "collection_method": {
      "type": "string",
      "enum": [
        "api_extract", "manual_curation", "web_scrape",
        "user_submission", "generated", "licensed", "other"
      ]
    },
    "collection_date_start": { "type": "string", "format": "date" },
    "collection_date_end": { "type": "string", "format": "date" },
    "curator": { "type": "string", "minLength": 1 },
    "curator_contact": { "type": "string" },
    "curator_notes": { "type": "string" },
    "quality_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "quality_score_breakdown": {
      "type": "object",
      "properties": {
        "completeness":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "accuracy":      { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "consistency":   { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "coverage":      { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "timeliness":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "provenance":    { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": ["Unvalidated", "In-Review", "Validated", "Failed", "Not-Applicable"]
    },
    "validation_date": { "type": "string", "format": "date" },
    "validation_report_ref": { "type": "string" },
    "known_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0
    },
    "known_biases": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0
    },
    "completeness_pct": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "duplicate_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_pct": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0
    },
    "license_id": { "type": "string", "minLength": 1 },
    "license_name": { "type": "string", "minLength": 1 },
    "license_url": { "type": "string", "format": "uri" },
    "license_restrictions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "privacy_tier": {
      "type": "string",
      "enum": ["Public", "Anonymous", "Pseudonymous", "Private", "Restricted"]
    },
    "privacy_notes": { "type": "string" },
    "confidence_tier": {
      "type": "string",
      "enum": ["Verified", "Estimated", "Rectified", "Synthetic", "Unknown"]
    },
    "confidence_notes": { "type": "string" },
    "contains_pii": { "type": "boolean" },
    "pii_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anonymization_method": { "type": "string" },
    "anonymization_date": { "type": "string", "format": "date" },
    "ethical_approval_ref": { "type": "string" },
    "ethical_notes": { "type": "string" },
    "consent_obtained": { "type": "boolean" },
    "format": { "type": "string", "minLength": 1 },
    "formats_available": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "record_count": { "type": "integer", "minimum": 0 },
    "field_count": { "type": "integer", "minimum": 0 },
    "file_size_bytes": { "type": "integer", "minimum": 0 },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checksum_algorithm": { "type": "string", "default": "sha256" },
    "compression": {
      "type": "string",
      "enum": ["none", "gzip", "zstd", "snappy"]
    },
    "schema_ref": { "type": "string", "minLength": 1 },
    "data_dictionary_ref": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string" },
    "computation_params": { "type": "object" },
    "lifecycle_stage": {
      "type": "string",
      "enum": ["Draft", "Candidacy", "Stable", "Deprecated", "Archived"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "deprecated_at": { "type": "string", "format": "date-time" },
    "archived_at": { "type": "string", "format": "date-time" },
    "maintainer": { "type": "string", "minLength": 1 },
    "maintainer_email": { "type": "string", "format": "email" },
    "review_date": { "type": "string", "format": "date" },
    "next_review_date": { "type": "string", "format": "date" },
    "changelog_ref": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "research_domains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intended_use": { "type": "string" },
    "prohibited_uses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language": { "type": "string" },
    "geographic_coverage": { "type": "string" },
    "temporal_coverage": {
      "type": "object",
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "dataset_git_ref": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "validation_status": { "enum": ["Validated", "Failed"] } }
      },
      "then": {
        "required": ["validation_date", "validation_report_ref"]
      }
    },
    {
      "if": {
        "properties": { "lifecycle_stage": { "enum": ["Stable", "Deprecated", "Archived"] } }
      },
      "then": {
        "required": ["published_at"]
      }
    },
    {
      "if": {
        "properties": { "lifecycle_stage": { "enum": ["Deprecated", "Archived"] } }
      },
      "then": {
        "required": ["deprecated_at"]
      }
    },
    {
      "if": {
        "properties": { "lifecycle_stage": { "const": "Archived" } }
      },
      "then": {
        "required": ["archived_at"]
      }
    },
    {
      "if": {
        "properties": { "contains_pii": { "const": true } }
      },
      "then": {
        "required": ["pii_fields"]
      }
    },
    {
      "if": {
        "properties": { "privacy_tier": { "enum": ["Anonymous", "Pseudonymous"] } }
      },
      "then": {
        "required": ["anonymization_method"]
      }
    },
    {
      "if": {
        "properties": { "privacy_tier": { "const": "Private" } }
      },
      "then": {
        "required": ["consent_obtained"]
      }
    }
  ]
}
