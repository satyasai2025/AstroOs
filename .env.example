# AstroOS — Local Development Environment
#
# Copy this file to `.env` in the project root (same directory as this file)
# before running the API, running tests, or generating migrations locally.
# pydantic-settings loads `.env` from the current working directory, so
# always run commands from the project root.
#
#   cp .env.example .env
#
# For PRODUCTION, see docs/production/configuration.md

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=AstroOS API
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# ── Database ────────────────────────────────────────────────────────────────
# asyncpg driver for the app; Alembic auto-converts to the sync psycopg2 URL
# internally (see apps/api/dependencies.py) — do not hand-edit that logic.
# Replace <db-password> with the POSTGRES_PASSWORD you set in docker-compose.yml
# (or your local Postgres instance) — do not reuse the same password across environments.
DATABASE_URL=postgresql+asyncpg://astroos:<db-password>@localhost:5432/astroos
DB_ECHO_SQL=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN_DENYLIST_TTL=604800

# ── JWT (RS256) ─────────────────────────────────────────────────────────────
# Keys are gitignored. Generate them before first run:
#   python apps/api/security/generate_keys.py
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=apps/api/security/keys/private.pem
JWT_PUBLIC_KEY_PATH=apps/api/security/keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Password hashing ────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── CORS / hosts ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["*"]

# ── Swiss Ephemeris ─────────────────────────────────────────────────────────
# .se1 data files already present in this repo under data/ephemeris/.
EPHEMERIS_PATH=data/ephemeris
EPHEMERIS_CACHE_TTL=3600

# ── Geocoding ───────────────────────────────────────────────────────────────
GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=AstroOS/2.0.0