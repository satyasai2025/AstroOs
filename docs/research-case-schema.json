{
  "": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchCaseBatchImportSchema",
  "$defs": {
    "AttachmentSchema": {
      "description": "A file attached to a life event.",
      "properties": {
        "type": {
          "default": "notes",
          "maxLength": 50,
          "title": "Type",
          "type": "string"
        },
        "filename": {
          "maxLength": 300,
          "title": "Filename",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "content_type": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        }
      },
      "required": [
        "filename"
      ],
      "title": "AttachmentSchema",
      "type": "object"
    },
    "BirthTimeConfidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "BirthTimeConfidence",
      "type": "string"
    },
    "DashaSnapshotSchema": {
      "description": "Dasha state at a point in time.",
      "properties": {
        "mahadasha": {
          "maxLength": 10,
          "title": "Mahadasha",
          "type": "string"
        },
        "antardasha": {
          "maxLength": 10,
          "title": "Antardasha",
          "type": "string"
        },
        "pratyantar": {
          "anyOf": [
            {
              "maxLength": 10,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pratyantar"
        }
      },
      "required": [
        "mahadasha",
        "antardasha"
      ],
      "title": "DashaSnapshotSchema",
      "type": "object"
    },
    "EventSnapshotSchema": {
      "description": "One astrological snapshot at a specific moment within an event window.",
      "properties": {
        "snapshot_date": {
          "format": "date",
          "title": "Snapshot Date",
          "type": "string"
        },
        "snapshot_version": {
          "default": "1.0",
          "maxLength": 20,
          "title": "Snapshot Version",
          "type": "string"
        },
        "current_dasha": {
          "anyOf": [
            {
              "$ref": "#/$defs/DashaSnapshotSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transits": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "boolean"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transits"
        },
        "shadbala": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shadbala"
        },
        "active_yogas": {
          "items": {
            "type": "string"
          },
          "title": "Active Yogas",
          "type": "array"
        },
        "varga_activations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Varga Activations",
          "type": "object"
        },
        "nakshatra_activations": {
          "items": {
            "type": "string"
          },
          "title": "Nakshatra Activations",
          "type": "array"
        },
        "house_lord_statuses": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "House Lord Statuses",
          "type": "object"
        }
      },
      "required": [
        "snapshot_date"
      ],
      "title": "EventSnapshotSchema",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "Marriage",
        "Divorce",
        "Promotion",
        "Job Change",
        "Accident",
        "Surgery",
        "Hospitalization",
        "Child Birth",
        "Death of Parent",
        "Death of Spouse",
        "Foreign Travel",
        "Education",
        "Property",
        "Vehicle",
        "Finance",
        "Business",
        "Political",
        "Spiritual",
        "Awards",
        "Litigation",
        "Health",
        "Other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "Gender": {
      "enum": [
        "Male",
        "Female",
        "Other"
      ],
      "title": "Gender",
      "type": "string"
    },
    "LifeEventCreateSchema": {
      "description": "One recorded life event for a research case.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        },
        "event_date": {
          "format": "date",
          "title": "Event Date",
          "type": "string"
        },
        "event_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HH:MM",
          "title": "Event Time"
        },
        "event_place": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Place"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "Moderate"
        },
        "category": {
          "default": "Other",
          "maxLength": 100,
          "title": "Category",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/SourceConfidence",
          "default": "medium"
        },
        "source": {
          "default": "self-report",
          "maxLength": 100,
          "title": "Source",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "event_window_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 0,
          "title": "Event Window Days",
          "type": "integer"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "snapshots": {
          "items": {
            "$ref": "#/$defs/EventSnapshotSchema"
          },
          "title": "Snapshots",
          "type": "array"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentSchema"
          },
          "title": "Attachments",
          "type": "array"
        }
      },
      "required": [
        "type",
        "event_date"
      ],
      "title": "LifeEventCreateSchema",
      "type": "object"
    },
    "PersonInfoSchema": {
      "description": "Birth and identity data for the research subject.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "gender": {
          "$ref": "#/$defs/Gender"
        },
        "dob": {
          "description": "Date of birth",
          "format": "date",
          "title": "Dob",
          "type": "string"
        },
        "tob": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time of birth (HH:MM)",
          "title": "Tob"
        },
        "place": {
          "description": "Place of birth",
          "maxLength": 300,
          "title": "Place",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "timezone": {
          "description": "IANA timezone, e.g. Asia/Kolkata",
          "maxLength": 100,
          "title": "Timezone",
          "type": "string"
        },
        "source": {
          "description": "Interview, Certificate, Self-report, etc.",
          "maxLength": 100,
          "title": "Source",
          "type": "string"
        },
        "birth_time_confidence": {
          "$ref": "#/$defs/BirthTimeConfidence",
          "default": "medium"
        }
      },
      "required": [
        "gender",
        "dob",
        "place",
        "latitude",
        "longitude",
        "timezone",
        "source"
      ],
      "title": "PersonInfoSchema",
      "type": "object"
    },
    "ResearchCaseCreateSchema": {
      "description": "Top-level import payload \u2014 one research case = one person + events.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "person": {
          "$ref": "#/$defs/PersonInfoSchema"
        },
        "ayanamsa": {
          "default": "lahiri",
          "maxLength": 50,
          "title": "Ayanamsa",
          "type": "string"
        },
        "house_system": {
          "default": "P",
          "maxLength": 50,
          "title": "House System",
          "type": "string"
        },
        "divisional_charts": {
          "items": {
            "type": "string"
          },
          "title": "Divisional Charts",
          "type": "array"
        },
        "rectified": {
          "default": false,
          "title": "Rectified",
          "type": "boolean"
        },
        "rectification_notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rectification Notes"
        },
        "life_events": {
          "items": {
            "$ref": "#/$defs/LifeEventCreateSchema"
          },
          "minItems": 1,
          "title": "Life Events",
          "type": "array"
        },
        "research_notes": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Notes"
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/AttachmentSchema"
          },
          "title": "Attachments",
          "type": "array"
        },
        "source_batch": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Batch"
        }
      },
      "required": [
        "person",
        "life_events"
      ],
      "title": "ResearchCaseCreateSchema",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "Major",
        "Moderate",
        "Minor"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SourceConfidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "SourceConfidence",
      "type": "string"
    }
  },
  "description": "Batch import \u2014 wraps multiple cases in one request.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/ResearchCaseCreateSchema"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "generate_ids": {
      "default": true,
      "title": "Generate Ids",
      "type": "boolean"
    }
  },
  "required": [
    "cases"
  ],
  "type": "object"
}